{
  "name": "mcprofile-bedrock-bridge-plugin",
  "version": "2.0.0",
  "description": "Comprehensive MCProfile.io integration plugin for Bedrock Bridge",
  "author": "KobeNetwork Development Team",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./api": "./api/mcprofile-api.js",
    "./core": "./core/index.js"
  },
  "keywords": [
    "bedrock",
    "bridge",
    "mcprofile",
    "plugin",
    "minecraft",
    "xuid",
    "floodgate",
    "java-uuid"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test-api": "python3 scripts/mcprofile-api-tester.py",
    "generate-config": "python3 scripts/profile-config-generator.py",
    "generate-config:prod": "python3 scripts/profile-config-generator.py production",
    "generate-config:dev": "python3 scripts/profile-config-generator.py development",
    "generate-config:perf": "python3 scripts/profile-config-generator.py high-performance",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docs": "jsdoc -c jsdoc.json"
  },
  "dependencies": {
    "@minecraft/server": "^1.11.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jsdoc": "^4.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kobenetwork/mcprofile-bedrock-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/kobenetwork/mcprofile-bedrock-plugin/issues"
  },
  "homepage": "https://github.com/kobenetwork/mcprofile-bedrock-plugin#readme",
  "files": [
    "index.js",
    "config/",
    "api/",
    "core/",
    "net/",
    "ui/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "config": "config",
    "scripts": "scripts"
  }
}
